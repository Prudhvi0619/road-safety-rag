# Copy this file to .env and replace placeholders locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
ROAD_RAG_LLM_MODEL=llama3.1
ROAD_RAG_NUM_CTX=16384
ROAD_RAG_EMBED_MODEL=BAAI/bge-base-en-v1.5
ROAD_RAG_ALLOW_MODEL_DOWNLOAD=false
ROAD_RAG_COLLECTION=road_safety_codes_v3
ROAD_RAG_DB_DIR=./local_data/chroma_db_v3
ROAD_RAG_CORPUS_DIRS=./local_data/standards
ROAD_RAG_ENABLE_RERANKER=false
ROAD_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
ROAD_RAG_STANDARDS_REGISTRY=./config/standards_registry.json
ROAD_RAG_REQUIRE_VERIFIED_STANDARDS=true
